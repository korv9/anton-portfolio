# ML: environment, run artefacts and model caches. Never weights or raw text.
ml/.venv/
ml/runs/
ml/.cache/
platform/.cache/

# The site's data: the active R2 releases, restored here by `npm run data:restore` and written
# by the exports. Never committed (docs/platform/storage-and-serving.md).
frontend/public/data/

# Wrangler local state
.wrangler/

# ProjectAtlas local index (SQLite), rebuilt by `projectatlas init`
.projectatlas/

# Idea Lineage: the private journal and every generated view stay local; only the public
# journal is committed (docs/platform/idea-lineage.md).
.idea-lineage/*
!.idea-lineage/public/

# pip install -e . metadata
*.egg-info/

# Local tool caches and per-machine editor config
.ruff_cache/
.import_linter_cache/
.arena/
.impeccable/
.claude/launch.json
