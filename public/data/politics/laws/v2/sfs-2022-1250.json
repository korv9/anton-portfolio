[{"provision_id":"sfs-2022-1250:P1","document_id":"sfs-2022-1250","provision_suffix":"P1","kind":"paragraph","source_anchor":"P1","source_anchor_occurrence":1,"label":"1 §","chapter":"","heading":"Lagens innehåll","order":1,"text":"Denna lag innehåller bestämmelser om hälso- och sjukvårdsåtgärder som utförs i form av egenvård.","subsection_anchors":["P1S2"],"amendment_notes":[],"document_title":"Lag (2022:1250) om egenvård","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2022-1250.html#P1","document_snapshot_id":"sfs-2022-1250:b6d85b382d04b8937c2d31b88c34fb01b29b688ec310ad3b44f8a0b95cfaf10f","title":"Lag (2022:1250) om egenvård","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2022-1250.html","source_sha256":"b6d85b382d04b8937c2d31b88c34fb01b29b688ec310ad3b44f8a0b95cfaf10f","retrieved_at":"2026-09-10T21:27:45+00:00"},{"provision_id":"sfs-2022-1250:P2","document_id":"sfs-2022-1250","provision_suffix":"P2","kind":"paragraph","source_anchor":"P2","source_anchor_occurrence":1,"label":"2 §","chapter":"","heading":"Uttryck i lagen","order":2,"text":"Med egenvård avses i denna lag en hälso- och sjukvårdsåtgärd som behandlande hälso- och sjukvårdspersonal har bedömt att en patient kan utföra själv eller med hjälp av någon annan.","subsection_anchors":["P2S2"],"amendment_notes":[],"document_title":"Lag (2022:1250) om egenvård","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2022-1250.html#P2","document_snapshot_id":"sfs-2022-1250:b6d85b382d04b8937c2d31b88c34fb01b29b688ec310ad3b44f8a0b95cfaf10f","title":"Lag (2022:1250) om egenvård","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2022-1250.html","source_sha256":"b6d85b382d04b8937c2d31b88c34fb01b29b688ec310ad3b44f8a0b95cfaf10f","retrieved_at":"2026-09-10T21:27:45+00:00"},{"provision_id":"sfs-2022-1250:P3","document_id":"sfs-2022-1250","provision_suffix":"P3","kind":"paragraph","source_anchor":"P3","source_anchor_occurrence":1,"label":"3 §","chapter":"","heading":"Uttryck i lagen","order":3,"text":"Med hälso- och sjukvårdsåtgärd avses i denna lag en åtgärd för att medicinskt förebygga, utreda eller behandla sjukdomar eller skador.","subsection_anchors":["P3S2"],"amendment_notes":[],"document_title":"Lag (2022:1250) om egenvård","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2022-1250.html#P3","document_snapshot_id":"sfs-2022-1250:b6d85b382d04b8937c2d31b88c34fb01b29b688ec310ad3b44f8a0b95cfaf10f","title":"Lag (2022:1250) om egenvård","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2022-1250.html","source_sha256":"b6d85b382d04b8937c2d31b88c34fb01b29b688ec310ad3b44f8a0b95cfaf10f","retrieved_at":"2026-09-10T21:27:45+00:00"},{"provision_id":"sfs-2022-1250:P4","document_id":"sfs-2022-1250","provision_suffix":"P4","kind":"paragraph","source_anchor":"P4","source_anchor_occurrence":1,"label":"4 §","chapter":"","heading":"Uttryck i lagen","order":4,"text":"Med hälso- och sjukvårdspersonal avses i denna lag den som har legitimation för ett yrke inom hälso- och sjukvården eller som enligt särskilt förordnande har fått motsvarande behörighet.","subsection_anchors":["P4S2"],"amendment_notes":[],"document_title":"Lag (2022:1250) om egenvård","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2022-1250.html#P4","document_snapshot_id":"sfs-2022-1250:b6d85b382d04b8937c2d31b88c34fb01b29b688ec310ad3b44f8a0b95cfaf10f","title":"Lag (2022:1250) om egenvård","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2022-1250.html","source_sha256":"b6d85b382d04b8937c2d31b88c34fb01b29b688ec310ad3b44f8a0b95cfaf10f","retrieved_at":"2026-09-10T21:27:45+00:00"},{"provision_id":"sfs-2022-1250:P5","document_id":"sfs-2022-1250","provision_suffix":"P5","kind":"paragraph","source_anchor":"P5","source_anchor_occurrence":1,"label":"5 §","chapter":"","heading":"Förhållandet till hälso- och sjukvårdslagen","order":5,"text":"När 