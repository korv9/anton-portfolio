[{"provision_id":"sfs-2023-454:P1","document_id":"sfs-2023-454","provision_suffix":"P1","kind":"paragraph","source_anchor":"P1","source_anchor_occurrence":1,"label":"1 §","chapter":"","heading":"Inledande bestämmelser","order":1,"text":"Denna lag innehåller bestämmelser om Utbetalningsmyndighetens system med transaktionskonto och om de utbetalningar som ska ske genom detta system.","subsection_anchors":["P1S2"],"amendment_notes":[],"document_title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html#P1","document_snapshot_id":"sfs-2023-454:22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html","source_sha256":"22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","retrieved_at":"2026-09-10T21:27:33+00:00"},{"provision_id":"sfs-2023-454:P2","document_id":"sfs-2023-454","provision_suffix":"P2","kind":"paragraph","source_anchor":"P2","source_anchor_occurrence":1,"label":"2 §","chapter":"","heading":"Inledande bestämmelser","order":2,"text":"Utbetalningsmyndigheten ska administrera ett system med transaktionskonto för utbetalningar från statliga myndigheter. De myndigheter som omfattas av systemet är Arbetsförmedlingen, Centrala studiestödsnämnden, Försäkringskassan, Pensionsmyndigheten och Skatteverket.","subsection_anchors":["P2S2"],"amendment_notes":[],"document_title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html#P2","document_snapshot_id":"sfs-2023-454:22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html","source_sha256":"22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","retrieved_at":"2026-09-10T21:27:33+00:00"},{"provision_id":"sfs-2023-454:P3","document_id":"sfs-2023-454","provision_suffix":"P3","kind":"paragraph","source_anchor":"P3","source_anchor_occurrence":1,"label":"3 §","chapter":"","heading":"Inledande bestämmelser","order":3,"text":"Med beslutande myndighet avses i lagen den myndighet som har beslutat att en utbetalning som omfattas av systemet med transaktionskonto ska ske.\n\nMed kreditinstitut avses i lagen kreditinstitut enligt lagen\n(2004:297) om bank- och finansieringsrörelse samt utländska kreditinstitut enligt samma lag om institutet har filial i Sverige.","subsection_anchors":["P3S2","P3S3"],"amendment_notes":[],"document_title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html#P3","document_snapshot_id":"sfs-2023-454:22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html","source_sha256":"22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","retrieved_at":"2026-09-10T21:27:33+00:00"},{"provision_id":"sfs-2023-454:P4","document_id":"sfs-2023-454","provision_suffix":"P4","kind":"paragraph","source_anchor":"P4","source_anchor_occurrence":1,"label":"4 §","chapter":"","heading":"Transaktionskonto","order":4,"text":"Utbetalningsmyndigheten ska registrera ett transaktionskonto för den som ska ta emot en utbetalning från systemet med transaktionskonto.","subsection_anchors":["P4S2"],"amendment_notes":[],"document_title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html#P4","document_snapshot_id":"sfs-2023-454:22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html","source_sha256":"22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","retrieved_at":"2026-09-10T21:27:33+00:00"},{"provision_id":"sfs-2023-454:P5","document_id":"sfs-2023-454","provision_suffix":"P5","kind":"paragraph","source_anchor":"P5","source_anchor_occurrence":1,"label":"5 §","chapter":"","heading":"Transaktionskonto","order":5,"text":"Ett belopp ska registreras på mottagarens transaktionskonto så snart Utbetalningsmyndigheten får ett underlag för utbetalningen från den beslutande myndigheten.","subsection_anchors":["P5S2"],"amendment_notes":[],"document_title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html#P5","document_snapshot_id":"sfs-2023-454:22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html","source_sha256":"22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","retrieved_at":"2026-09-10T21:27:33+00:00"},{"provision_id":"sfs-2023-454:P6","document_id":"sfs-2023-454","provision_suffix":"P6","kind":"paragraph","source_anchor":"P6","source_anchor_occurrence":1,"label":"6 §","chapter":"","heading":"Transaktionskonto","order":6,"text":"Det belopp som har registrerats på ett transaktionskonto ska betalas ut den dag som den beslutande myndigheten har bestämt.","subsection_anchors":["P6S2"],"amendment_notes":[],"document_title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html#P6","document_snapshot_id":"sfs-2023-454:22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html","source_sha256":"22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","retrieved_at":"2026-09-10T21:27:33+00:00"},{"provision_id":"sfs-2023-454:P7","document_id":"sfs-2023-454","provision_suffix":"P7","kind":"paragraph","source_anchor":"P7","source_anchor_occurrence":1,"label":"7 §","chapter":"","heading":"Transaktionskonto","order":7,"text":"En utbetalning ska anses verkställd av den beslutande myndigheten den dag som beloppet ska betalas ut, även om utbetalningen inte har kunnat genomföras.","subsection_anchors":["P7S2"],"amendment_notes":[],"document_title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html#P7","document_snapshot_id":"sfs-2023-454:22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html","source_sha256":"22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","retrieved_at":"2026-09-10T21:27:33+00:00"},{"provision_id":"sfs-2023-454:P8","document_id":"sfs-2023-454","provision_suffix":"P8","kind":"paragraph","source_anchor":"P8","source_anchor_occurrence":1,"label":"8 §","chapter":"","heading":"Transaktionskonto","order":8,"text":"Ett tillgodohavande på ett transaktionskonto ska betalas till ett konto hos ett kreditinstitut. Kontot ska tillhöra mottagaren av utbetalningen.\n\nOm Utbetalningsmyndigheten saknar uppgift om ett sådant konto, eller om det annars på grund av särskilda förhållanden finns behov av det, får utbetalning ske på annat sätt.","subsection_anchors":["P8S2","P8S3"],"amendment_notes":[],"document_title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html#P8","document_snapshot_id":"sfs-2023-454:22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html","source_sha256":"22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","retrieved_at":"2026-09-10T21:27:33+00:00"},{"provision_id":"sfs-2023-454:P9","document_id":"sfs-2023-454","provision_suffix":"P9","kind":"paragraph","source_anchor":"P9","source_anchor_occurrence":1,"label":"9 §","chapter":"","heading":"Transaktionskonto","order":9,"text":"Ett belopp på ett transaktionskonto får inte överlåtas innan det ska betalas ut.","subsection_anchors":["P9S2"],"amendment_notes":[],"document_title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html#P9","document_snapshot_id":"sfs-2023-454:22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html","source_sha256":"22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","retrieved_at":"2026-09-10T21:27:33+00:00"},{"provision_id":"sfs-2023-454:P10","document_id":"sfs-2023-454","provision_suffix":"P10","kind":"paragraph","source_anchor":"P10","source_anchor_occurrence":1,"label":"10 §","chapter":"","heading":"Preskription","order":10,"text":"Ett tillgodohavande som inte kan betalas ut ska stå kvar på transaktionskontot.\n\nEtt tillgodohavande preskriberas tio år från den tidpunkt som anges i 6 §, om inte preskriptionen avbryts dessförinnan. Ett tillgodohavande som har preskriberats tillfaller staten.","subsection_anchors":["P10S2","P10S3"],"amendment_notes":[],"document_title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html#P10","document_snapshot_id":"sfs-2023-454:22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html","source_sha256":"22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","retrieved_at":"2026-09-10T21:27:33+00:00"},{"provision_id":"sfs-2023-454:P11","document_id":"sfs-2023-454","provision_suffix":"P11","kind":"paragraph","source_anchor":"P11","source_anchor_occurrence":1,"label":"11 §","chapter":"","heading":"Utmätning","order":11,"text":"Ett belopp som har registrerats på ett transaktionskonto får utmätas trots att det inte får överlåtas enligt 9 §.","subsection_anchors":["P11S2"],"amendment_notes":[],"document_title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html#P11","document_snapshot_id":"sfs-2023-454:22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html","source_sha256":"22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","retrieved_at":"2026-09-10T21:27:33+00:00"},{"provision_id":"sfs-2023-454:P12","document_id":"sfs-2023-454","provision_suffix":"P12","kind":"paragraph","source_anchor":"P12","source_anchor_occurrence":1,"label":"12 §","chapter":"","heading":"Rätt att meddela föreskrifter","order":12,"text":"Regeringen eller den myndighet som regeringen bestämmer kan med stöd av 8 kap. 7 § regeringsformen meddela föreskrifter om\n\n1. vilka slags utbetalningar som ska administreras via systemet med transaktionskonto, och\n\n2. hur utbetalningar som ska administreras via systemet med transaktionskonto ska göras.","subsection_anchors":["P12S2"],"amendment_notes":[],"document_title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html#P12","document_snapshot_id":"sfs-2023-454:22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html","source_sha256":"22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","retrieved_at":"2026-09-10T21:27:33+00:00"},{"provision_id":"sfs-2023-454:overgang:2023-454","document_id":"sfs-2023-454","provision_suffix":"overgang:2023-454","kind":"transitional_provision","source_anchor":"overgang","source_anchor_occurrence":1,"label":"SFS 2023:454","chapter":"","heading":"Övergångsbestämmelser","order":13,"text":"2023:454\n\n1. Denna lag träder i kraft den 1 januari 2024.\n\n2. Senast den 1 januari 2027 ska alla utbetalningar som omfattas av lagen administreras via systemet med transaktionskonto.","subsection_anchors":[],"amendment_notes":[],"document_title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html#overgang","document_snapshot_id":"sfs-2023-454:22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","title":"Lag (2023:454) om transaktionskonto vid Utbetalningsmyndigheten","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2023-454.html","source_sha256":"22b5e1425851eead3ce75529bb28f080cfbe0693e2704fb0ee3ac16bb1f9afbd","retrieved_at":"2026-09-10T21:27:33+00:00"}]