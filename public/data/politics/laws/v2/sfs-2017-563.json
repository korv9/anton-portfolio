[{"provision_id":"sfs-2017-563:P1","document_id":"sfs-2017-563","provision_suffix":"P1","kind":"paragraph","source_anchor":"P1","source_anchor_occurrence":1,"label":"1 §","chapter":"","heading":"Inledande bestämmelser","order":1,"text":"I denna lag finns bestämmelser om det allmänna museiväsendet. Med det allmänna museiväsendet avses\n\n1. statliga museer,\n\n2. regionala museer,\n\n3. kommunala museer, och\n\n4. andra museer i vars styrelse eller motsvarande ledningsorgan mer än hälften av antalet ledamöter är utsedda av stat, kommun eller region. Lag (2019:977).","subsection_anchors":["P1S2"],"amendment_notes":["Lag (2019:977)"],"document_title":"Museilag (2017:563)","document_version":"t.o.m. SFS 2019:977","source_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html#P1","document_snapshot_id":"sfs-2017-563:004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","title":"Museilag (2017:563)","version":"t.o.m. SFS 2019:977","source_page_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html","source_sha256":"004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","retrieved_at":"2026-09-10T21:29:46+00:00"},{"provision_id":"sfs-2017-563:P2","document_id":"sfs-2017-563","provision_suffix":"P2","kind":"paragraph","source_anchor":"P2","source_anchor_occurrence":1,"label":"2 §","chapter":"","heading":"Inledande bestämmelser","order":2,"text":"Med ett museum avses i denna lag en institution som är öppen för allmänheten och som förvärvar, bevarar, undersöker, förmedlar och ställer ut materiella och immateriella vittnesbörd om människan och människans omvärld.","subsection_anchors":["P2S2"],"amendment_notes":[],"document_title":"Museilag (2017:563)","document_version":"t.o.m. SFS 2019:977","source_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html#P2","document_snapshot_id":"sfs-2017-563:004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","title":"Museilag (2017:563)","version":"t.o.m. SFS 2019:977","source_page_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html","source_sha256":"004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","retrieved_at":"2026-09-10T21:29:46+00:00"},{"provision_id":"sfs-2017-563:P3","document_id":"sfs-2017-563","provision_suffix":"P3","kind":"paragraph","source_anchor":"P3","source_anchor_occurrence":1,"label":"3 §","chapter":"","heading":"Inledande bestämmelser","order":3,"text":"Med museihuvudmän avses i denna lag staten, kommunerna och regionerna.\n\nDet som sägs om museihuvudmän gäller även den som utsett mer än hälften av antalet ledamöter i ett sådant museum som avses i 1 § 4. Lag (2019:977).","subsection_anchors":["P3S2","P3S3"],"amendment_notes":["Lag (2019:977)"],"document_title":"Museilag (2017:563)","document_version":"t.o.m. SFS 2019:977","source_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html#P3","document_snapshot_id":"sfs-2017-563:004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","title":"Museilag (2017:563)","version":"t.o.m. SFS 2019:977","source_page_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html","source_sha256":"004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","retrieved_at":"2026-09-10T21:29:46+00:00"},{"provision_id":"sfs-2017-563:P4","document_id":"sfs-2017-563","provision_suffix":"P4","kind":"paragraph","source_anchor":"P4","source_anchor_occurrence":1,"label":"4 §","chapter":"","heading":"Ändamål","order":4,"text":"Ett museum ska utifrån sitt ämnesområde bidra till samhället och dess utveckling genom att främja kunskap, kulturupplevelser och fri åsiktsbildning.","subsection_anchors":["P4S2"],"amendment_notes":[],"document_title":"Museilag (2017:563)","document_version":"t.o.m. SFS 2019:977","source_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html#P4","document_snapshot_id":"sfs-2017-563:004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","title":"Museilag (2017:563)","version":"t.o.m. SFS 2019:977","source_page_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html","source_sha256":"004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","retrieved_at":"2026-09-10T21:29:46+00:00"},{"provision_id":"sfs-2017-563:P5","document_id":"sfs-2017-563","provision_suffix":"P5","kind":"paragraph","source_anchor":"P5","source_anchor_occurrence":1,"label":"5 §","chapter":"","heading":"Ansvarsfördelning","order":5,"text":"Museihuvudmännen ska säkerställa att ett museum har ett bestämmande inflytande över verksamhetens innehåll.","subsection_anchors":["P5S2"],"amendment_notes":[],"document_title":"Museilag (2017:563)","document_version":"t.o.m. SFS 2019:977","source_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html#P5","document_snapshot_id":"sfs-2017-563:004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","title":"Museilag (2017:563)","version":"t.o.m. SFS 2019:977","source_page_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html","source_sha256":"004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","retrieved_at":"2026-09-10T21:29:46+00:00"},{"provision_id":"sfs-2017-563:P6","document_id":"sfs-2017-563","provision_suffix":"P6","kind":"paragraph","source_anchor":"P6","source_anchor_occurrence":1,"label":"6 §","chapter":"","heading":"Publik verksamhet","order":6,"text":"Utställningar och annan publik verksamhet vid ett museum ska vara kunskapsbaserad och präglas av allsidighet och öppenhet.","subsection_anchors":["P6S2"],"amendment_notes":[],"document_title":"Museilag (2017:563)","document_version":"t.o.m. SFS 2019:977","source_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html#P6","document_snapshot_id":"sfs-2017-563:004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","title":"Museilag (2017:563)","version":"t.o.m. SFS 2019:977","source_page_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html","source_sha256":"004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","retrieved_at":"2026-09-10T21:29:46+00:00"},{"provision_id":"sfs-2017-563:P7","document_id":"sfs-2017-563","provision_suffix":"P7","kind":"paragraph","source_anchor":"P7","source_anchor_occurrence":1,"label":"7 §","chapter":"","heading":"Publik verksamhet","order":7,"text":"Utställningar och annan publik verksamhet vid ett museum ska vara tillgänglig för alla och anpassad till användarnas olika förutsättningar.","subsection_anchors":["P7S2"],"amendment_notes":[],"document_title":"Museilag (2017:563)","document_version":"t.o.m. SFS 2019:977","source_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html#P7","document_snapshot_id":"sfs-2017-563:004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","title":"Museilag (2017:563)","version":"t.o.m. SFS 2019:977","source_page_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html","source_sha256":"004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","retrieved_at":"2026-09-10T21:29:46+00:00"},{"provision_id":"sfs-2017-563:P8","document_id":"sfs-2017-563","provision_suffix":"P8","kind":"paragraph","source_anchor":"P8","source_anchor_occurrence":1,"label":"8 §","chapter":"","heading":"Kunskapsuppbyggnad","order":8,"text":"Ett museum ska bidra till forskning och annan kunskapsuppbyggnad, bland annat genom att ha hög kompetens inom sitt ämnesområde.","subsection_anchors":["P8S2"],"amendment_notes":[],"document_title":"Museilag (2017:563)","document_version":"t.o.m. SFS 2019:977","source_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html#P8","document_snapshot_id":"sfs-2017-563:004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","title":"Museilag (2017:563)","version":"t.o.m. SFS 2019:977","source_page_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html","source_sha256":"004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","retrieved_at":"2026-09-10T21:29:46+00:00"},{"provision_id":"sfs-2017-563:P9","document_id":"sfs-2017-563","provision_suffix":"P9","kind":"paragraph","source_anchor":"P9","source_anchor_occurrence":1,"label":"9 §","chapter":"","heading":"Förvaltning av samlingar","order":9,"text":"Ett museum ska aktivt förvalta sina samlingar för att nå verksamhetens mål.","subsection_anchors":["P9S2"],"amendment_notes":[],"document_title":"Museilag (2017:563)","document_version":"t.o.m. SFS 2019:977","source_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html#P9","document_snapshot_id":"sfs-2017-563:004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","title":"Museilag (2017:563)","version":"t.o.m. SFS 2019:977","source_page_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html","source_sha256":"004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","retrieved_at":"2026-09-10T21:29:46+00:00"},{"provision_id":"sfs-2017-563:P10","document_id":"sfs-2017-563","provision_suffix":"P10","kind":"paragraph","source_anchor":"P10","source_anchor_occurrence":1,"label":"10 §","chapter":"","heading":"Förvaltning av samlingar","order":10,"text":"Regeringen får meddela föreskrifter om att de statliga museerna får överlåta föremål ur sina samlingar till andra museer inom det allmänna museiväsendet.\n\nRegeringen får även meddela föreskrifter om förfoganden över sådana föremål i de statliga museernas samlingar som har ett begränsat kulturhistoriskt värde.","subsection_anchors":["P10S2","P10S3"],"amendment_notes":[],"document_title":"Museilag (2017:563)","document_version":"t.o.m. SFS 2019:977","source_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html#P10","document_snapshot_id":"sfs-2017-563:004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","title":"Museilag (2017:563)","version":"t.o.m. SFS 2019:977","source_page_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html","source_sha256":"004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","retrieved_at":"2026-09-10T21:29:46+00:00"},{"provision_id":"sfs-2017-563:P11","document_id":"sfs-2017-563","provision_suffix":"P11","kind":"paragraph","source_anchor":"P11","source_anchor_occurrence":1,"label":"11 §","chapter":"","heading":"Samverkan och spridning i hela landet","order":11,"text":"Museerna och museihuvudmännen ska samverka i syfte att ge alla tillgång till museernas samlade resurser, bland annat genom att ställa föremål ur de egna samlingarna till varandras förfogande.","subsection_anchors":["P11S2"],"amendment_notes":[],"document_title":"Museilag (2017:563)","document_version":"t.o.m. SFS 2019:977","source_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html#P11","document_snapshot_id":"sfs-2017-563:004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","title":"Museilag (2017:563)","version":"t.o.m. SFS 2019:977","source_page_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html","source_sha256":"004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","retrieved_at":"2026-09-10T21:29:46+00:00"},{"provision_id":"sfs-2017-563:P12","document_id":"sfs-2017-563","provision_suffix":"P12","kind":"paragraph","source_anchor":"P12","source_anchor_occurrence":1,"label":"12 §","chapter":"","heading":"Samverkan och spridning i hela landet","order":12,"text":"Bestämmelsen i 2 kap. 1 § kommunallagen (2017:725) om anknytning till kommunens område eller dess medlemmar hindrar inte att kommunala museer avgiftsfritt ställer föremål ur sina samlingar till förfogande för ett museum i det allmänna museiväsendet som är beläget utanför kommungränsen.\nLag (2017:774).","subsection_anchors":[],"amendment_notes":["Lag (2017:774)"],"document_title":"Museilag (2017:563)","document_version":"t.o.m. SFS 2019:977","source_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html#P12","document_snapshot_id":"sfs-2017-563:004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","title":"Museilag (2017:563)","version":"t.o.m. SFS 2019:977","source_page_url":"https://data.riksdagen.se/dokument/sfs-2017-563.html","source_sha256":"004906b2b8aee38de88b8bc0ba5d9de1e35b19c6d7407b7ee2dbd0ae3d19b26b","retrieved_at":"2026-09-10T21:29:46+00:00"}]