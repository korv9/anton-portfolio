[{"provision_id":"sfs-2022-759:P1","document_id":"sfs-2022-759","provision_suffix":"P1","kind":"paragraph","source_anchor":"P1","source_anchor_occurrence":1,"label":"1 §","chapter":"","heading":"","order":1,"text":"I denna lag finns bestämmelser om Fondtorgsnämnden.","subsection_anchors":["P1S2"],"amendment_notes":[],"document_title":"Lag (2022:759) om Fondtorgsnämnden","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2022-759.html#P1","document_snapshot_id":"sfs-2022-759:6b9b9e9d57ba6b73f95625125a61b24081601e33239296d382d0ff3b3aea25e8","title":"Lag (2022:759) om Fondtorgsnämnden","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2022-759.html","source_sha256":"6b9b9e9d57ba6b73f95625125a61b24081601e33239296d382d0ff3b3aea25e8","retrieved_at":"2026-09-10T21:27:52+00:00"},{"provision_id":"sfs-2022-759:P2","document_id":"sfs-2022-759","provision_suffix":"P2","kind":"paragraph","source_anchor":"P2","source_anchor_occurrence":1,"label":"2 §","chapter":"","heading":"","order":2,"text":"Fondtorgsnämnden ska verka för att målen för premiepensionssystemet uppnås genom att förvalta premiepensionens fondtorg.","subsection_anchors":["P2S2"],"amendment_notes":[],"document_title":"Lag (2022:759) om Fondtorgsnämnden","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2022-759.html#P2","document_snapshot_id":"sfs-2022-759:6b9b9e9d57ba6b73f95625125a61b24081601e33239296d382d0ff3b3aea25e8","title":"Lag (2022:759) om Fondtorgsnämnden","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2022-759.html","source_sha256":"6b9b9e9d57ba6b73f95625125a61b24081601e33239296d382d0ff3b3aea25e8","retrieved_at":"2026-09-10T21:27:52+00:00"},{"provision_id":"sfs-2022-759:P3","document_id":"sfs-2022-759","provision_suffix":"P3","kind":"paragraph","source_anchor":"P3","source_anchor_occurrence":1,"label":"3 §","chapter":"","heading":"","order":3,"text":"Fondtorgsnämnden ska upphandla fonder till fondtorget för premiepensionen enligt lagen (2022:760) om upphandling av fonder till premiepensionens fondtorg.\n\nFondtorgsnämnden ska ingå sådana fondavtal som avses i 1 kap.\n3 § lagen om upphandling av fonder till premiepensionens fondtorg.","subsection_anchors":["P3S2","P3S3"],"amendment_notes":[],"document_title":"Lag (2022:759) om Fondtorgsnämnden","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2022-759.html#P3","document_snapshot_id":"sfs-2022-759:6b9b9e9d57ba6b73f95625125a61b24081601e33239296d382d0ff3b3aea25e8","title":"Lag (2022:759) om Fondtorgsnämnden","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2022-759.html","source_sha256":"6b9b9e9d57ba6b73f95625125a61b24081601e33239296d382d0ff3b3aea25e8","retrieved_at":"2026-09-10T21:27:52+00:00"},{"provision_id":"sfs-2022-759:P4","document_id":"sfs-2022-759","provision_suffix":"P4","kind":"paragraph","source_anchor":"P4","source_anchor_occurrence":1,"label":"4 §","chapter":"","heading":"","order":4,"text":"Fondtorgsnämnden ska granska att fondförvaltare och fonder löpande uppfyller villkoren i fondavtalen.\n\nFondtorgsnämnden ska även regelbundet utvärdera fondförvaltarnas förvaltning av medlen i de upphandlade fonderna.","subsection_anchors":["P4S2","P4S3"],"amendment_notes":[],"document_title":"Lag (2022:759) om Fondtorgsnämnden","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2022-759.html#P4","document_snapshot_id":"sfs-2022-759:6b9b9e9d57ba6b73f95625125a61b24081601e33239296d382d0ff3b3aea25e8","title":"Lag (2022:759) om Fondtorgsnämnden","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2022-759.html","source_sha256":"6b9b9e9d57ba6b73f95625125a61b24081601e33239296d382d0ff3b3aea25e8","retrieved_at":"2026-09-10T21:27:52+00:00"},{"provision_id":"sfs-2022-759:P5","document_id":"sfs-2022-759","provision_suffix":"P5","kind":"paragraph","source_anchor":"P5","source_anchor_occurrence":1,"label":"5 §","chapter":"","heading":"","order":5,"text":"Fondtorgsnämnden ska fortlöpande förvalta premiepensionens fondtorg enligt 64 kap. 3 a-3 c §§ socialförsäkringsbalken.","subsection_anchors":["P5S2"],"amendment_notes":[],"document_title":"Lag (2022:759) om Fondtorgsnämnden","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2022-759.html#P5","document_snapshot_id":"sfs-2022-759:6b9b9e9d57ba6b73f95625125a61b24081601e33239296d382d0ff3b3aea25e8","title":"Lag (2022:759) om Fondtorgsnämnden","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2022-759.html","source_sha256":"6b9b9e9d57ba6b73f95625125a61b24081601e33239296d382d0ff3b3aea25e8","retrieved_at":"2026-09-10T21:27:52+00:00"},{"provision_id":"sfs-2022-759:P6","document_id":"sfs-2022-759","provision_suffix":"P6","kind":"paragraph","source_anchor":"P6","source_anchor_occurrence":1,"label":"6 §","chapter":"","heading":"","order":6,"text":"Fondtorgsnämnden ska ta ut en avgift från de fondförvaltare som ger in en anbudsansökan eller ett anbud i en upphandling enligt lagen (2022:760) om upphandling av fonder till premiepensionens fondtorg för att täcka myndighetens kostnader för att granska och pröva anbudsansökan eller anbudet.\n\nFondförvaltaren ska betala avgiften senast när anbudsansökan eller anbudet ges in. Om fondförvaltaren inte gör detta, ska förvaltaren föreläggas att betala avgiften inom en viss tid. Följer fondförvaltaren inte föreläggandet ska anbudsansökan eller anbudet avvisas. Fondförvaltaren ska underrättas om detta i föreläggandet.\n\nFondtorgsnämnden får, om det finns särskilda skäl, betala tillbaka hela eller delar av avgiften.","subsection_anchors":["P6S2","P6S3","P6S4"],"amendment_notes":[],"document_title":"Lag (2022:759) om Fondtorgsnämnden","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2022-759.html#P6","document_snapshot_id":"sfs-2022-759:6b9b9e9d57ba6b73f95625125a61b24081601e33239296d382d0ff3b3aea25e8","title":"Lag (2022:759) om Fondtorgsnämnden","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2022-759.html","source_sha256":"6b9b9e9d57ba6b73f95625125a61b24081601e33239296d382d0ff3b3aea25e8","retrieved_at":"2026-09-10T21:27:52+00:00"},{"provision_id":"sfs-2022-759:P7","document_id":"sfs-2022-759","provision_suffix":"P7","kind":"paragraph","source_anchor":"P7","source_anchor_occurrence":1,"label":"7 §","chapter":"","heading":"","order":7,"text":"Fondtorgsnämnden ska ta ut årliga avgifter från de fondförvaltare som Fondtorgsnämnden har ingått fondavtal med för att täcka sina kostnader för\n\n1. upphandling av fonder enligt lagen (2022:760) om upphandling av fonder till premiepensionens fondtorg, till den del kostnaderna inte täcks av avgifter enligt 6 §, och\n\n2. verksamhet enligt 4 § respektive 64 kap. 3 b och 3 c §§ socialförsäkringsbalken som har anknytning till Fondtorgsnämndens verksamhet att förvalta fondtorget.\n\nFondtorgsnämnden bestämmer när avgiften ska tas ut.","subsection_anchors":["P7S2","P7S3"],"amendment_notes":[],"document_title":"Lag (2022:759) om Fondtorgsnämnden","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2022-759.html#P7","document_snapshot_id":"sfs-2022-759:6b9b9e9d57ba6b73f95625125a61b24081601e33239296d382d0ff3b3aea25e8","title":"Lag (2022:759) om Fondtorgsnämnden","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2022-759.html","source_sha256":"6b9b9e9d57ba6b73f95625125a61b24081601e33239296d382d0ff3b3aea25e8","retrieved_at":"2026-09-10T21:27:52+00:00"},{"provision_id":"sfs-2022-759:P8","document_id":"sfs-2022-759","provision_suffix":"P8","kind":"paragraph","source_anchor":"P8","source_anchor_occurrence":1,"label":"8 §","chapter":"","heading":"","order":8,"text":"Fondtorgsnämnden bestämmer hur avgifterna enligt 6 och\n7 §§ ska beräknas.","subsection_anchors":[],"amendment_notes":[],"document_title":"Lag (2022:759) om Fondtorgsnämnden","document_version":null,"source_url":"https://data.riksdagen.se/dokument/sfs-2022-759.html#P8","document_snapshot_id":"sfs-2022-759:6b9b9e9d57ba6b73f95625125a61b24081601e33239296d382d0ff3b3aea25e8","title":"Lag (2022:759) om Fondtorgsnämnden","version":null,"source_page_url":"https://data.riksdagen.se/dokument/sfs-2022-759.html","source_sha256":"6b9b9e9d57ba6b73f95625125a61b24081601e33239296d382d0ff3b3aea25e8","retrieved_at":"2026-09-10T21:27:52+00:00"}]