[{"provision_id":"sfs-2018-1139:P1","document_id":"sfs-2018-1139","provision_suffix":"P1","kind":"paragraph","source_anchor":"P1","source_anchor_occurrence":1,"label":"1 §","chapter":"","heading":"Lagens tillämpningsområde","order":1,"text":"Spelskatt ska betalas till staten för sådant licenspliktigt spel som tillhandahålls av en licenshavare enligt spellagen (2018:1138).","subsection_anchors":["P1S2"],"amendment_notes":[],"document_title":"Lag (2018:1139) om skatt på spel","document_version":"t.o.m. SFS 2025:768","source_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html#P1","document_snapshot_id":"sfs-2018-1139:f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","title":"Lag (2018:1139) om skatt på spel","version":"t.o.m. SFS 2025:768","source_page_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html","source_sha256":"f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","retrieved_at":"2026-09-10T21:29:23+00:00"},{"provision_id":"sfs-2018-1139:P2","document_id":"sfs-2018-1139","provision_suffix":"P2","kind":"paragraph","source_anchor":"P2","source_anchor_occurrence":1,"label":"2 §","chapter":"","heading":"Lagens tillämpningsområde","order":2,"text":"Från spelskatt undantas spel enligt 6 kap. spellagen\n(2018:1138).\n\nFörsta stycket gäller inte sådant spel som avses i 2 kap. 5 § samma lag. Lag (2025:768).","subsection_anchors":["P2S2","P2S3"],"amendment_notes":["Lag (2025:768)"],"document_title":"Lag (2018:1139) om skatt på spel","document_version":"t.o.m. SFS 2025:768","source_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html#P2","document_snapshot_id":"sfs-2018-1139:f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","title":"Lag (2018:1139) om skatt på spel","version":"t.o.m. SFS 2025:768","source_page_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html","source_sha256":"f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","retrieved_at":"2026-09-10T21:29:23+00:00"},{"provision_id":"sfs-2018-1139:P3","document_id":"sfs-2018-1139","provision_suffix":"P3","kind":"paragraph","source_anchor":"P3","source_anchor_occurrence":1,"label":"3 §","chapter":"","heading":"Definitioner","order":3,"text":"I denna lag avses med\n\n1. insats: det värde som spelaren eller annan betalar för spelarens deltagande i spel som omfattas av denna lag,\n\n2. utbetalning: det värde som den skattskyldige eller dennes ombud betalar till spelaren genom att tillgodoföra belopp på spelkontot eller på annat sätt.\n\nÖvriga ord och uttryck i denna lag har samma betydelse som i spellagen (2018:1138).","subsection_anchors":["P3S2","P3S3"],"amendment_notes":[],"document_title":"Lag (2018:1139) om skatt på spel","document_version":"t.o.m. SFS 2025:768","source_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html#P3","document_snapshot_id":"sfs-2018-1139:f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","title":"Lag (2018:1139) om skatt på spel","version":"t.o.m. SFS 2025:768","source_page_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html","source_sha256":"f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","retrieved_at":"2026-09-10T21:29:23+00:00"},{"provision_id":"sfs-2018-1139:P4","document_id":"sfs-2018-1139","provision_suffix":"P4","kind":"paragraph","source_anchor":"P4","source_anchor_occurrence":1,"label":"4 §","chapter":"","heading":"Skattskyldighet","order":4,"text":"Skattskyldig är innehavare av licens som meddelats med stöd av spellagen (2018:1138) för sådant spel som omfattas av denna lag.","subsection_anchors":["P4S2"],"amendment_notes":[],"document_title":"Lag (2018:1139) om skatt på spel","document_version":"t.o.m. SFS 2025:768","source_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html#P4","document_snapshot_id":"sfs-2018-1139:f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","title":"Lag (2018:1139) om skatt på spel","version":"t.o.m. SFS 2025:768","source_page_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html","source_sha256":"f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","retrieved_at":"2026-09-10T21:29:23+00:00"},{"provision_id":"sfs-2018-1139:P5","document_id":"sfs-2018-1139","provision_suffix":"P5","kind":"paragraph","source_anchor":"P5","source_anchor_occurrence":1,"label":"5 §","chapter":"","heading":"Skattskyldighetens inträde","order":5,"text":"Skattskyldigheten inträder när den skattskyldige tar emot insatser för sådant spel som omfattas av denna lag.","subsection_anchors":["P5S2"],"amendment_notes":[],"document_title":"Lag (2018:1139) om skatt på spel","document_version":"t.o.m. SFS 2025:768","source_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html#P5","document_snapshot_id":"sfs-2018-1139:f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","title":"Lag (2018:1139) om skatt på spel","version":"t.o.m. SFS 2025:768","source_page_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html","source_sha256":"f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","retrieved_at":"2026-09-10T21:29:23+00:00"},{"provision_id":"sfs-2018-1139:P6","document_id":"sfs-2018-1139","provision_suffix":"P6","kind":"paragraph","source_anchor":"P6","source_anchor_occurrence":1,"label":"6 §","chapter":"","heading":"Underlaget för spelskatt","order":6,"text":"Spelskatt ska betalas för behållningen för varje beskattningsperiod som avser sådant spel som omfattas av denna lag.","subsection_anchors":["P6S2"],"amendment_notes":[],"document_title":"Lag (2018:1139) om skatt på spel","document_version":"t.o.m. SFS 2025:768","source_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html#P6","document_snapshot_id":"sfs-2018-1139:f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","title":"Lag (2018:1139) om skatt på spel","version":"t.o.m. SFS 2025:768","source_page_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html","source_sha256":"f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","retrieved_at":"2026-09-10T21:29:23+00:00"},{"provision_id":"sfs-2018-1139:P7","document_id":"sfs-2018-1139","provision_suffix":"P7","kind":"paragraph","source_anchor":"P7","source_anchor_occurrence":1,"label":"7 §","chapter":"","heading":"Underlaget för spelskatt","order":7,"text":"Behållningen för en beskattningsperiod beräknas som skillnaden mellan de sammanlagda insatserna som den skattskyldige tagit emot och de sammanlagda utbetalningarna som den skattskyldige betalat ut under perioden.\n\nVid bestämmande av behållningen ska endast insatser och utbetalningar som hänför sig till det svenska speldeltagandet beaktas.\n\nSom svenskt speldeltagande räknas endast\n\n1. deltagande i onlinespel, om spelaren är bosatt eller stadigvarande vistas i Sverige, och\n\n2. deltagande i annat spel än onlinespel, om spelet tillhandahålls på svenskt territorium. Lag (2022:1675).","subsection_anchors":["P7S2","P7S3","P7S4"],"amendment_notes":["Lag (2022:1675)"],"document_title":"Lag (2018:1139) om skatt på spel","document_version":"t.o.m. SFS 2025:768","source_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html#P7","document_snapshot_id":"sfs-2018-1139:f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","title":"Lag (2018:1139) om skatt på spel","version":"t.o.m. SFS 2025:768","source_page_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html","source_sha256":"f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","retrieved_at":"2026-09-10T21:29:23+00:00"},{"provision_id":"sfs-2018-1139:P8","document_id":"sfs-2018-1139","provision_suffix":"P8","kind":"paragraph","source_anchor":"P8","source_anchor_occurrence":1,"label":"8 §","chapter":"","heading":"Underlaget för spelskatt","order":8,"text":"En beskattningsperiod utgörs av en kalendermånad.","subsection_anchors":["P8S2"],"amendment_notes":[],"document_title":"Lag (2018:1139) om skatt på spel","document_version":"t.o.m. SFS 2025:768","source_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html#P8","document_snapshot_id":"sfs-2018-1139:f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","title":"Lag (2018:1139) om skatt på spel","version":"t.o.m. SFS 2025:768","source_page_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html","source_sha256":"f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","retrieved_at":"2026-09-10T21:29:23+00:00"},{"provision_id":"sfs-2018-1139:P9","document_id":"sfs-2018-1139","provision_suffix":"P9","kind":"paragraph","source_anchor":"P9","source_anchor_occurrence":1,"label":"9 §","chapter":"","heading":"Skattens storlek","order":9,"text":"Spelskatt ska betalas med 22 procent av behållningen för en beskattningsperiod. Lag (2024:276).","subsection_anchors":["P9S2"],"amendment_notes":["Lag (2024:276)"],"document_title":"Lag (2018:1139) om skatt på spel","document_version":"t.o.m. SFS 2025:768","source_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html#P9","document_snapshot_id":"sfs-2018-1139:f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","title":"Lag (2018:1139) om skatt på spel","version":"t.o.m. SFS 2025:768","source_page_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html","source_sha256":"f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","retrieved_at":"2026-09-10T21:29:23+00:00"},{"provision_id":"sfs-2018-1139:P10","document_id":"sfs-2018-1139","provision_suffix":"P10","kind":"paragraph","source_anchor":"P10","source_anchor_occurrence":1,"label":"10 §","chapter":"","heading":"Förfarandet","order":10,"text":"Bestämmelser om förfarandet vid uttag av skatten finns i skatteförfarandelagen (2011:1244).","subsection_anchors":["P10S2"],"amendment_notes":[],"document_title":"Lag (2018:1139) om skatt på spel","document_version":"t.o.m. SFS 2025:768","source_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html#P10","document_snapshot_id":"sfs-2018-1139:f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","title":"Lag (2018:1139) om skatt på spel","version":"t.o.m. SFS 2025:768","source_page_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html","source_sha256":"f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","retrieved_at":"2026-09-10T21:29:23+00:00"},{"provision_id":"sfs-2018-1139:overgang:2018-1139","document_id":"sfs-2018-1139","provision_suffix":"overgang:2018-1139","kind":"transitional_provision","source_anchor":"overgang","source_anchor_occurrence":1,"label":"SFS 2018:1139","chapter":"","heading":"Övergångsbestämmelser","order":11,"text":"2018:1139\n\n1. Denna lag träder i kraft den 1 januari 2019.\n\n2. Genom lagen upphävs\n\na) lagen (1972:820) om skatt på spel,\n\nb) lagen (1991:1482) om lotteriskatt, och\n\nc) lagen (1991:1483) om skatt på vinstsparande m.m.\n\n3. De upphävda lagarna gäller dock fortfarande för förhållanden som hänför sig till tiden före ikraftträdandet.\n\n4. Vid tillämpningen av denna lag ska med\n\na) licenshavare jämställas den som har tillstånd enligt 25,\n27, 32 eller 34 § lotterilagen (1994:1000), och\n\nb) licenspliktigt spel jämställas spel med tillstånd enligt\n25, 27, 32 eller 34 § lotterilagen. Lag (2018:2038).","subsection_anchors":[],"amendment_notes":[],"document_title":"Lag (2018:1139) om skatt på spel","document_version":"t.o.m. SFS 2025:768","source_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html#overgang","document_snapshot_id":"sfs-2018-1139:f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","title":"Lag (2018:1139) om skatt på spel","version":"t.o.m. SFS 2025:768","source_page_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html","source_sha256":"f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","retrieved_at":"2026-09-10T21:29:23+00:00"},{"provision_id":"sfs-2018-1139:overgang:2022-1675","document_id":"sfs-2018-1139","provision_suffix":"overgang:2022-1675","kind":"transitional_provision","source_anchor":"overgang","source_anchor_occurrence":1,"label":"SFS 2022:1675","chapter":"","heading":"Övergångsbestämmelser","order":12,"text":"2022:1675\n\n1. Denna lag träder i kraft den 1 januari 2023.\n\n2. Äldre bestämmelser gäller fortfarande för förhållanden som hänför sig till tiden före ikraftträdandet.","subsection_anchors":[],"amendment_notes":[],"document_title":"Lag (2018:1139) om skatt på spel","document_version":"t.o.m. SFS 2025:768","source_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html#overgang","document_snapshot_id":"sfs-2018-1139:f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","title":"Lag (2018:1139) om skatt på spel","version":"t.o.m. SFS 2025:768","source_page_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html","source_sha256":"f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","retrieved_at":"2026-09-10T21:29:23+00:00"},{"provision_id":"sfs-2018-1139:overgang:2024-276","document_id":"sfs-2018-1139","provision_suffix":"overgang:2024-276","kind":"transitional_provision","source_anchor":"overgang","source_anchor_occurrence":1,"label":"SFS 2024:276","chapter":"","heading":"Övergångsbestämmelser","order":13,"text":"2024:276\n\n1. Denna lag träder i kraft den 1 juli 2024.\n\n2. Äldre bestämmelser gäller fortfarande för förhållanden som hänför sig till tiden före ikraftträdandet.","subsection_anchors":[],"amendment_notes":[],"document_title":"Lag (2018:1139) om skatt på spel","document_version":"t.o.m. SFS 2025:768","source_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html#overgang","document_snapshot_id":"sfs-2018-1139:f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","title":"Lag (2018:1139) om skatt på spel","version":"t.o.m. SFS 2025:768","source_page_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html","source_sha256":"f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","retrieved_at":"2026-09-10T21:29:23+00:00"},{"provision_id":"sfs-2018-1139:overgang:2025-768","document_id":"sfs-2018-1139","provision_suffix":"overgang:2025-768","kind":"transitional_provision","source_anchor":"overgang","source_anchor_occurrence":1,"label":"SFS 2025:768","chapter":"","heading":"Övergångsbestämmelser","order":14,"text":"2025:768\n\n1. Denna lag träder i kraft den 1 januari 2026.\n\n2. Äldre bestämmelser gäller fortfarande för insatser som tagits emot och utbetalningar som betalats ut före ikraftträdandet.","subsection_anchors":[],"amendment_notes":[],"document_title":"Lag (2018:1139) om skatt på spel","document_version":"t.o.m. SFS 2025:768","source_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html#overgang","document_snapshot_id":"sfs-2018-1139:f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","title":"Lag (2018:1139) om skatt på spel","version":"t.o.m. SFS 2025:768","source_page_url":"https://data.riksdagen.se/dokument/sfs-2018-1139.html","source_sha256":"f3a68c841c861be6d0ab4d6082bf221c3f2eca3b416fe1b707576d3e7e35d835","retrieved_at":"2026-09-10T21:29:23+00:00"}]