[{"provision_id":"sfs-2014-307:P1","document_id":"sfs-2014-307","provision_suffix":"P1","kind":"paragraph","source_anchor":"P1","source_anchor_occurrence":1,"label":"1 §","chapter":"","heading":"Lagens tillämpningsområde","order":1,"text":"Denna lag innehåller straffrättsliga bestämmelser om penningtvätt.\n\nI lagen (2017:630) om åtgärder mot penningtvätt och finansiering av terrorism finns bestämmelser om åtgärder som den som bedriver finansiell verksamhet och annan näringsverksamhet är skyldig att vidta för att förhindra att verksamheten utnyttjas för penningtvätt eller finansiering av terrorism. Lag (2017:660).","subsection_anchors":["P1S2","P1S3"],"amendment_notes":["Lag (2017:660)"],"document_title":"Lag (2014:307) om straff för penningtvättsbrott","document_version":"t.o.m SFS 2026:1323","source_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html#P1","document_snapshot_id":"sfs-2014-307:5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","title":"Lag (2014:307) om straff för penningtvättsbrott","version":"t.o.m SFS 2026:1323","source_page_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html","source_sha256":"5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","retrieved_at":"2026-09-10T21:31:14+00:00"},{"provision_id":"sfs-2014-307:P2","document_id":"sfs-2014-307","provision_suffix":"P2","kind":"paragraph","source_anchor":"P2","source_anchor_occurrence":1,"label":"2 §","chapter":"","heading":"Lagens tillämpningsområde","order":2,"text":"Med brott i 3 och 4 §§ avses\n\n1. gärning som utgör brott enligt svensk lag, eller\n\n2. gärning som utgör brott enligt utländsk lag och som motsvarar brott enligt svensk lag.","subsection_anchors":["P2S2"],"amendment_notes":[],"document_title":"Lag (2014:307) om straff för penningtvättsbrott","document_version":"t.o.m SFS 2026:1323","source_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html#P2","document_snapshot_id":"sfs-2014-307:5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","title":"Lag (2014:307) om straff för penningtvättsbrott","version":"t.o.m SFS 2026:1323","source_page_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html","source_sha256":"5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","retrieved_at":"2026-09-10T21:31:14+00:00"},{"provision_id":"sfs-2014-307:P3","document_id":"sfs-2014-307","provision_suffix":"P3","kind":"paragraph","source_anchor":"P3","source_anchor_occurrence":1,"label":"3 §","chapter":"","heading":"Ansvar","order":3,"text":"För penningtvättsbrott döms, om åtgärden syftar till att dölja att pengar eller annan egendom härrör från brott eller brottslig verksamhet eller till att främja möjligheterna för någon att tillgodogöra sig egendomen eller dess värde, den som\n\n1. överlåter, förvärvar, omsätter, förvarar eller vidtar annan sådan åtgärd med egendomen, eller\n\n2. tillhandahåller, förvärvar eller upprättar en handling som kan ge en skenbar förklaring till innehavet av egendomen, deltar i transaktioner som utförs för skens skull, uppträder som bulvan eller vidtar annan sådan åtgärd.\n\nStraffet är fängelse i högst två år.","subsection_anchors":["P3S2","P3S3"],"amendment_notes":[],"document_title":"Lag (2014:307) om straff för penningtvättsbrott","document_version":"t.o.m SFS 2026:1323","source_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html#P3","document_snapshot_id":"sfs-2014-307:5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","title":"Lag (2014:307) om straff för penningtvättsbrott","version":"t.o.m SFS 2026:1323","source_page_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html","source_sha256":"5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","retrieved_at":"2026-09-10T21:31:14+00:00"},{"provision_id":"sfs-2014-307:P4","document_id":"sfs-2014-307","provision_suffix":"P4","kind":"paragraph","source_anchor":"P4","source_anchor_occurrence":1,"label":"4 §","chapter":"","heading":"Ansvar","order":4,"text":"För penningtvättsbrott döms även den som, utan att åtgärden har ett sådant syfte som anges i 3 §, otillbörligen främjar möjligheterna för någon att omsätta pengar eller annan egendom som härrör från brott eller brottslig verksamhet.","subsection_anchors":["P4S2"],"amendment_notes":[],"document_title":"Lag (2014:307) om straff för penningtvättsbrott","document_version":"t.o.m SFS 2026:1323","source_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html#P4","document_snapshot_id":"sfs-2014-307:5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","title":"Lag (2014:307) om straff för penningtvättsbrott","version":"t.o.m SFS 2026:1323","source_page_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html","source_sha256":"5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","retrieved_at":"2026-09-10T21:31:14+00:00"},{"provision_id":"sfs-2014-307:P5","document_id":"sfs-2014-307","provision_suffix":"P5","kind":"paragraph","source_anchor":"P5","source_anchor_occurrence":1,"label":"5 §","chapter":"","heading":"Ansvar","order":5,"text":"Är brott som avses i 3 eller 4 § grovt, döms för grovt penningtvättsbrott till fängelse i lägst ett och högst sex år.\n\nVid bedömningen av om brottet är grovt ska det särskilt beaktas om gärningen avsett betydande värden, om de brottsliga åtgärderna har ingått som ett led i en brottslighet som utövats systematiskt eller i större omfattning eller i annat fall varit av särskilt farlig art. Lag (2026:1323).","subsection_anchors":["P5S2","P5S3"],"amendment_notes":["Lag (2026:1323)"],"document_title":"Lag (2014:307) om straff för penningtvättsbrott","document_version":"t.o.m SFS 2026:1323","source_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html#P5","document_snapshot_id":"sfs-2014-307:5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","title":"Lag (2014:307) om straff för penningtvättsbrott","version":"t.o.m SFS 2026:1323","source_page_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html","source_sha256":"5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","retrieved_at":"2026-09-10T21:31:14+00:00"},{"provision_id":"sfs-2014-307:P6","document_id":"sfs-2014-307","provision_suffix":"P6","kind":"paragraph","source_anchor":"P6","source_anchor_occurrence":1,"label":"6 §","chapter":"","heading":"Ansvar","order":6,"text":"Är brott som avses i 3 eller 4 § ringa, döms för penningtvättsförseelse till böter eller fängelse i högst sex månader.\n\nFör penningtvättsförseelse döms även den som i fall som avses i 3 eller 4 § inte insåg men hade skälig anledning att anta att egendomen härrörde från brott eller brottslig verksamhet.","subsection_anchors":["P6S2","P6S3"],"amendment_notes":[],"document_title":"Lag (2014:307) om straff för penningtvättsbrott","document_version":"t.o.m SFS 2026:1323","source_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html#P6","document_snapshot_id":"sfs-2014-307:5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","title":"Lag (2014:307) om straff för penningtvättsbrott","version":"t.o.m SFS 2026:1323","source_page_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html","source_sha256":"5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","retrieved_at":"2026-09-10T21:31:14+00:00"},{"provision_id":"sfs-2014-307:P7","document_id":"sfs-2014-307","provision_suffix":"P7","kind":"paragraph","source_anchor":"P7","source_anchor_occurrence":1,"label":"7 §","chapter":"","heading":"Ansvar","order":7,"text":"Den som, i näringsverksamhet eller såsom led i en verksamhet som bedrivs vanemässigt eller annars i större omfattning, medverkar till en åtgärd som skäligen kan antas vara vidtagen i sådant syfte som anges i 3 §, döms för näringspenningtvätt till fängelse i högst två år.\n\nÄr brottet grovt, döms till fängelse i lägst ett och högst sex år.\n\nÄr brottet ringa, döms till böter eller fängelse i högst sex månader. Till samma straff döms den som i annat fall än som anges i första stycket medverkar till en åtgärd som skäligen kan antas vara vidtagen i sådant syfte som anges i 3 §.\nLag (2026:1323).","subsection_anchors":["P7S2","P7S3","P7S4"],"amendment_notes":["Lag (2026:1323)"],"document_title":"Lag (2014:307) om straff för penningtvättsbrott","document_version":"t.o.m SFS 2026:1323","source_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html#P7","document_snapshot_id":"sfs-2014-307:5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","title":"Lag (2014:307) om straff för penningtvättsbrott","version":"t.o.m SFS 2026:1323","source_page_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html","source_sha256":"5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","retrieved_at":"2026-09-10T21:31:14+00:00"},{"provision_id":"sfs-2014-307:P8","document_id":"sfs-2014-307","provision_suffix":"P8","kind":"paragraph","source_anchor":"P8","source_anchor_occurrence":1,"label":"8 §","chapter":"","heading":"Ansvar","order":8,"text":"För försök, förberedelse eller stämpling till penningtvättsbrott, grovt penningtvättsbrott eller näringspenningtvätt som inte är ringa, döms det till ansvar enligt 23 kap. brottsbalken.","subsection_anchors":["P8S2"],"amendment_notes":[],"document_title":"Lag (2014:307) om straff för penningtvättsbrott","document_version":"t.o.m SFS 2026:1323","source_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html#P8","document_snapshot_id":"sfs-2014-307:5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","title":"Lag (2014:307) om straff för penningtvättsbrott","version":"t.o.m SFS 2026:1323","source_page_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html","source_sha256":"5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","retrieved_at":"2026-09-10T21:31:14+00:00"},{"provision_id":"sfs-2014-307:P9","document_id":"sfs-2014-307","provision_suffix":"P9","kind":"paragraph","source_anchor":"P9","source_anchor_occurrence":1,"label":"9 §","chapter":"","heading":"Ansvar","order":9,"text":"Har upphävts genom lag (2024:874).","subsection_anchors":["P9S2"],"amendment_notes":["lag (2024:874)"],"document_title":"Lag (2014:307) om straff för penningtvättsbrott","document_version":"t.o.m SFS 2026:1323","source_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html#P9","document_snapshot_id":"sfs-2014-307:5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","title":"Lag (2014:307) om straff för penningtvättsbrott","version":"t.o.m SFS 2026:1323","source_page_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html","source_sha256":"5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","retrieved_at":"2026-09-10T21:31:14+00:00"},{"provision_id":"sfs-2014-307:P10","document_id":"sfs-2014-307","provision_suffix":"P10","kind":"paragraph","source_anchor":"P10","source_anchor_occurrence":1,"label":"10 §","chapter":"","heading":"Ansvar","order":10,"text":"Har upphävts genom lag (2024:874).","subsection_anchors":["P10S2"],"amendment_notes":["lag (2024:874)"],"document_title":"Lag (2014:307) om straff för penningtvättsbrott","document_version":"t.o.m SFS 2026:1323","source_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html#P10","document_snapshot_id":"sfs-2014-307:5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","title":"Lag (2014:307) om straff för penningtvättsbrott","version":"t.o.m SFS 2026:1323","source_page_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html","source_sha256":"5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","retrieved_at":"2026-09-10T21:31:14+00:00"},{"provision_id":"sfs-2014-307:P11","document_id":"sfs-2014-307","provision_suffix":"P11","kind":"paragraph","source_anchor":"P11","source_anchor_occurrence":1,"label":"11 §","chapter":"","heading":"Särskilda bestämmelser om förverkande","order":11,"text":"Förverkande av egendom som har varit föremål för brott enligt denna lag får ske hos gärningsmannen eller hos den som har medverkat till brottet, även om egendomen tillhör någon annan. Lag (2024:874).","subsection_anchors":["P11S2"],"amendment_notes":["Lag (2024:874)"],"document_title":"Lag (2014:307) om straff för penningtvättsbrott","document_version":"t.o.m SFS 2026:1323","source_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html#P11","document_snapshot_id":"sfs-2014-307:5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","title":"Lag (2014:307) om straff för penningtvättsbrott","version":"t.o.m SFS 2026:1323","source_page_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html","source_sha256":"5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","retrieved_at":"2026-09-10T21:31:14+00:00"},{"provision_id":"sfs-2014-307:P12","document_id":"sfs-2014-307","provision_suffix":"P12","kind":"paragraph","source_anchor":"P12","source_anchor_occurrence":1,"label":"12 §","chapter":"","heading":"Särskilda bestämmelser om förverkande","order":12,"text":"Har upphävts genom lag (2024:874).","subsection_anchors":["P12S2"],"amendment_notes":["lag (2024:874)"],"document_title":"Lag (2014:307) om straff för penningtvättsbrott","document_version":"t.o.m SFS 2026:1323","source_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html#P12","document_snapshot_id":"sfs-2014-307:5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","title":"Lag (2014:307) om straff för penningtvättsbrott","version":"t.o.m SFS 2026:1323","source_page_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html","source_sha256":"5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","retrieved_at":"2026-09-10T21:31:14+00:00"},{"provision_id":"sfs-2014-307:P13","document_id":"sfs-2014-307","provision_suffix":"P13","kind":"paragraph","source_anchor":"P13","source_anchor_occurrence":1,"label":"13 §","chapter":"","heading":"Särskilda bestämmelser om förverkande","order":13,"text":"Har upphävts genom lag (2024:874).","subsection_anchors":[],"amendment_notes":["lag (2024:874)"],"document_title":"Lag (2014:307) om straff för penningtvättsbrott","document_version":"t.o.m SFS 2026:1323","source_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html#P13","document_snapshot_id":"sfs-2014-307:5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","title":"Lag (2014:307) om straff för penningtvättsbrott","version":"t.o.m SFS 2026:1323","source_page_url":"https://data.riksdagen.se/dokument/sfs-2014-307.html","source_sha256":"5c96e898811ca0d4737a3d94052e7ebbb9efecafc72eac7fce08e193014b009d","retrieved_at":"2026-09-10T21:31:14+00:00"}]