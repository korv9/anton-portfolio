# Response headers on Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Vite names every built asset by its content hash, so it never changes under the same name.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Data files keep their names across refreshes: cache briefly and revalidate.
/data/*
  Cache-Control: public, max-age=300, must-revalidate
