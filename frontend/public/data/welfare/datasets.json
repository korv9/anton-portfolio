 {
  "table": "mart_county_year_panel",
  "role": "serving",
  "path": "parquet/welfare/mart_county_year_panel.parquet",
  "rows": 462,
  "description": "Counties and the country by calendar year, one column per measure, each aggregated by its rule. For regression, correlation and maps. Carries numerators and denominators (unemployed and labour force, sick-pay days and insured) so regions combine correctly. County-level associations describe counties, not individuals.",
  "columns": [
   {
    "name": "region_code",
    "type": "VARCHAR",
    "description": "SCB region code: 00 the country, two digits a county."
   },
   {
    "name": "region_name",
    "type": "VARCHAR",
    "description": "Region name."
   },
   {
    "name": "is_country",
    "type": "BOOLEAN",
    "description": "True for the country row (00); exclude it when aggregating counties."
   },
   {
    "name": "nuts2_code",
    "type": "VARCHAR",
    "description": "NUTS2 area (riksområde) of the county."
   },
   {
    "name": "year",
    "type": "INTEGER",
    "description": "Calendar year."
   },
   {
    "name": "year_start",
    "type": "DATE",
    "description": "1 January of the year; the semantic layer's time dimension."
   },
   {
    "name": "population",
    "type": "DOUBLE",
    "description": "SCB population on 31 December (stock: add counties, never years)."
   },
   {
    "name": "population_is_perturbed",
    "type": "BOOLEAN",
    "description": "True for years published under SCB's cell key method (small per-cell noise)."
   },
   {
    "name": "unemployment_rate_pct",
    "type": "DOUBLE",
    "description": "AKU, 15-74, SCB's published annual rate; margin in unemployment_rate_moe."
   },
   {
    "name": "unemployment_rate_moe",
    "type": "DOUBLE",
    "description": "95% margin of error of unemployment_rate_pct, percentage points."
   },
   {
    "name": "employment_rate_pct",
    "type": "DOUBLE",
    "description": "AKU employment rate, 15-74, per cent of the population, published annual figure."
   },
   {
    "name": "unemployed_thousands",
    "type": "DOUBLE",
    "description": "AKU unemployed, thousands; numerator for combining regions."
   },
   {
    "name": "labour_force_thousands",
    "type": "DOUBLE",
    "description": "AKU labour force (employed + unemployed), thousands; denominator for combining regions."
   },
   {
    "name": "sick_pay_rate_days",
    "type": "DOUBLE",
    "description": "FK sjukpenningtal 2.0 in December (a rolling twelve-month measure), from 2021."
   },
   {
    "name": "sick_pay_days",
