[
  {
    "AllowedOrigins": [
      "*"
    ],
    "AllowedMethods": [
      "GET",
      "HEAD"
    ],
    "AllowedHeaders": [
      "range",
      "if-match",
      "if-none-match"
    ],
    "ExposeHeaders": [
      "content-length",
      "content-range",
      "etag",
      "accept-ranges"
    ],
    "MaxAgeSeconds": 3600
  }
]
