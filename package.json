{
  "name": "anton-ernstsson-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b frontend && vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts --host 127.0.0.1",
    "check": "tsc -b frontend && tsc -p worker",
    "test:e2e": "playwright test --config frontend/playwright.config.ts",
    "test:unit": "node --test frontend/tests/unit/*.test.ts",
    "format": "prettier --write frontend/src frontend/tests frontend/*.ts",
    "format:check": "prettier --check frontend/src frontend/tests frontend/*.ts",
    "data:build": "python platform/legacy/build_gold.py && npm run politics:build && python platform/legacy/build_products.py && python platform/legacy/build_speech_browser.py && python platform/publish/export_debates.py && python platform/publish/build_catalog.py",
    "politics:build": "cd platform && dbt build --profiles-dir . --select +tag:politics --target-path target/politics && cd .. && python platform/publish/export_politics.py",
    "politics:check": "cd platform && dbt build --profiles-dir . --select +tag:politics --exclude tag:parliament --target-path target/politics && cd .. && python platform/publish/export_politics.py --check",
    "politics:debates": "python platform/publish/export_debates.py",
    "tallman:index": "python platform/tallman/build_index.py",
    "tallman:eval": "node platform/tallman/eval/run.ts",
    "data:catalog": "python platform/publish/build_catalog.py",
    "data:parquet": "python platform/publish/build_parquet.py",
    "data:upload": "python platform/publish/upload.py",
    "data:check": "python platform/legacy/validate_gold.py && python platform/legacy/validate_budget_context.py && python platform/legacy/validate_products.py && python platform/legacy/validate_politics.py",
    "welfare:fetch": "python platform/ingest/run_welfare.py --skip-build",
    "welfare:build": "python platform/ingest/run_welfare.py --skip-fetch",
    "welfare": "python platform/ingest/run_welfare.py",
    "parliament:fetch": "python platform/ingest/run_parliament.py --skip-build",
    "parliament:build": "python platform/ingest/run_parliament.py --skip-fetch",
    "parliament": "python platform/ingest/run_parliament.py && python platform/publish/export_parliament.py",
    "taxes": "python platform/ingest/run_taxes.py && python platform/publish/export_taxes.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "hyparquet": "^1.31.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@cloudflare/workers-types": "^5.20260929.1",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.9.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.143.0"
  }
}
