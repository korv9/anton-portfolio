{
  "name": "anton-ernstsson-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts --host 127.0.0.1 --port 5173 --strictPort",
    "build": "npm run compliance:check && npm run jobs:check && tsc -b frontend && vite build --config frontend/vite.config.ts",
    "jobs:check": "node --experimental-strip-types scripts/check_job_companies.mjs",
    "compliance:check": "node --experimental-strip-types scripts/check_compliance_release.mjs",
    "preview": "vite preview --config frontend/vite.config.ts --host 127.0.0.1",
    "check": "tsc -b frontend",
    "test:e2e": "playwright test --config frontend/playwright.config.ts",
    "test:security": "npm run build && npm run test:security:built",
    "test:security:built": "playwright test --config frontend/security.playwright.config.ts",
    "verify:quick": "node scripts/verify.mjs quick",
    "verify:full": "node scripts/verify.mjs full",
    "verify:delivery": "node scripts/verify.mjs delivery",
    "workspaces": "python scripts/workspaces.py",
    "test:unit": "node --experimental-strip-types --test frontend/tests/unit/*.test.ts worker/*.test.ts",
    "format": "prettier --write frontend/src frontend/tests frontend/*.ts worker",
    "format:check": "prettier --check frontend/src frontend/tests frontend/*.ts worker",
    "data:build": "python platform/pipeline.py run legacy",
    "politics:build": "python platform/pipeline.py run politics",
    "politics:check": "python platform/pipeline.py run politics_check",
    "politics:parties": "python platform/publish/export_party_profiles.py",
    "politics:debates": "python platform/publish/export_debates.py",
    "pipeline": "python platform/pipeline.py",
    "data:catalog": "python platform/publish/build_catalog.py",
    "data:parquet": "python platform/publish/build_parquet.py",
    "data:upload": "python platform/publish/upload.py",
    "data:check": "python platform/pipeline.py check",
    "welfare:fetch": "python platform/pipeline.py run welfare --only ingest",
    "welfare:build": "python platform/pipeline.py run welfare --only dbt",
    "welfare": "python platform/pipeline.py run welfare",
    "parliament:fetch": "python platform/pipeline.py run parliament --only ingest",
    "parliament:build": "python platform/pipeline.py run parliament --only dbt",
    "parliament": "python platform/pipeline.py run parliament",
    "taxes": "python platform/pipeline.py run taxes",
    "ideas:extract": "python platform/idea_lineage/extract.py",
    "ideas:add": "python platform/idea_lineage/add.py",
    "ideas:state": "python platform/idea_lineage/views.py state",
    "ideas:diary": "python platform/idea_lineage/views.py diary",
    "ideas:export": "python platform/idea_lineage/views.py export",
    "ideas:build": "python platform/idea_lineage/views.py all",
    "ideas:search": "python platform/idea_lineage/query.py search",
    "ideas:history": "python platform/idea_lineage/query.py history",
    "ideas:why": "python platform/idea_lineage/query.py why",
    "architecture:build": "python platform/architecture/build_graph.py",
    "ai-act:ingest": "python platform/pipeline.py run ai_act --only ingest",
    "ai-act:build": "python platform/pipeline.py run ai_act --only dbt",
    "ai-act:publish": "python platform/pipeline.py run ai_act --only export",
    "ai-act": "python platform/pipeline.py run ai_act",
    "ai-politics:ingest": "python platform/pipeline.py run ai_politics --only ingest",
    "ai-politics:build": "python platform/pipeline.py run ai_politics --only dbt:1",
    "ai-politics:similarity": "python platform/pipeline.py run ai_politics --only ml,dbt:2 --ml always",
    "ai-politics:publish": "python platform/pipeline.py run ai_politics --only export",
    "philosophy": "python platform/pipeline.py run philosophy --ml stale",
    "job-ai-governance": "python platform/pipeline.py run job_ai_governance",
    "ai-politics": "python platform/pipeline.py run ai_politics --ml stale",
    "symbolic:ingest": "python platform/pipeline.py run symbolic --only ingest",
    "symbolic:audit": "python platform/ingest/symbolic/audit_corpus.py",
    "symbolic:validity": "python platform/nlp/symbolic/validity.py",
    "symbolic:silver": "python platform/pipeline.py run symbolic --only dbt:1",
    "symbolic:gold": "python platform/pipeline.py run symbolic --only dbt:2",
    "symbolic:ml": "python platform/pipeline.py run symbolic --only ml --ml always",
    "symbolic:publish": "python platform/pipeline.py run symbolic --only export",
    "symbolic:experiments": "python platform/nlp/symbolic/experiments.py",
    "symbolic:clean": "python platform/nlp/symbolic/cleaning_report.py --snapshot && npm run symbolic:silver && python platform/nlp/symbolic/cleaning_report.py",
    "symbolic:review": "python platform/nlp/symbolic/rank_clusters.py book_centered",
    "symbolic:research": "npm run symbolic:clean && npm run symbolic:experiments && npm run symbolic:validity && npm run symbolic:ml && npm run symbolic:gold && npm run symbolic:review && npm run symbolic:publish",
    "symbolic:build": "python platform/pipeline.py run symbolic --ml stale",
    "concepts:build": "python platform/pipeline.py run concepts --only ml --ml always",
    "concepts:dbt": "python platform/pipeline.py run concepts --only dbt",
    "concepts:publish": "python platform/pipeline.py run concepts --only export",
    "concepts": "python platform/pipeline.py run concepts --ml stale",
    "ai-governance-timeline": "python platform/pipeline.py run cross_domain",
    "quality:build": "python platform/pipeline.py run quality --only ingest,dbt",
    "quality:publish": "python platform/pipeline.py run quality --only export",
    "quality": "python platform/pipeline.py run quality"
