{
  "name": "anton-ernstsson-portfolio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "data:build": "python scripts/build-gold.py && python scripts/build-budget-context.py && python scripts/build-products.py && python scripts/build-speech-browser.py && python scripts/build-catalog.py",
    "data:check": "python scripts/validate-gold.py && python scripts/validate-budget-context.py && python scripts/validate-products.py && python scripts/validate-politics.py",
    "check": "tsc -b",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "data:catalog": "python scripts/build-catalog.py"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.32.0",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "prettier": "^3.9.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
