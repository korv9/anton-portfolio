  "dependencies": {
    "hyparquet": "^1.31.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "0.169.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "0.169.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.8",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.151.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
