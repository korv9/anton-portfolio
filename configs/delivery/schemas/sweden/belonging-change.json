{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["balanced_visits", "periods", "lost_service_point", "recovery", "within", "supply_use", "method"],
  "properties": {
    "balanced_visits": {"type": "object", "required": ["municipalities", "totals"]},
    "periods": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["from", "to", "visits", "service_points"]}},
    "recovery": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["from", "to", "all", "groups"]}},
    "within": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["years", "municipalities"]}},
    "supply_use": {"type": "object", "minProperties": 1},
    "method": {"type": "object", "minProperties": 1}
  }
}
