{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["method", "criterion", "explained_variance", "loadings", "permutation", "splits", "sensitivity", "excluded", "limits", "provenance"],
  "properties": {
    "explained_variance": {"type": "array", "minItems": 1},
    "loadings": {"type": "object", "minProperties": 1},
    "splits": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["k", "role", "silhouette", "profiles"]}},
    "provenance": {
      "type": "object",
      "required": ["run", "sources", "run_id", "code_sha"],
      "properties": {
        "run_id": {"type": ["string", "null"]},
        "code_sha": {"type": ["string", "null"]}
      }
    }
  }
}
