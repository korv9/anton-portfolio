{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["generated_at", "items", "sources", "method"],
  "properties": {
    "generated_at": {"type": "string", "minLength": 10},
    "items": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "title", "published_at", "url"]}},
    "sources": {"type": "object", "minProperties": 1},
    "method": {"type": "string", "minLength": 1}
  }
}
