{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["generated_at", "years", "latest_year", "ytd_months", "last_month", "fields", "monthly", "occupations", "regions", "conditions", "archives", "method"],
  "properties": {
    "generated_at": {"type": "string", "minLength": 10},
    "years": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer"}},
    "latest_year": {"type": "integer"},
    "ytd_months": {"type": "integer", "minimum": 1, "maximum": 12},
    "last_month": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "fields": {"type": "array", "minItems": 1},
    "monthly": {"type": "object", "required": ["all"], "properties": {"all": {"type": "array", "minItems": 1}}},
    "occupations": {"type": "array"},
    "regions": {"type": "array"},
    "conditions": {"type": "object"},
    "archives": {"type": "array", "minItems": 1},
    "method": {"type": "string", "minLength": 1}
  }
}
