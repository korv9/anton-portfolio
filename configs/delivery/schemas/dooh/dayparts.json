{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "year",
    "service_date",
    "mean_hourly_boardings",
    "stations",
    "groups"
  ],
  "properties": {
    "stations": {
      "type": "array",
      "minItems": 100,
      "items": {
        "type": "object",
        "required": [
          "station_key",
          "index",
          "boardings",
          "morning_share",
          "afternoon_share",
          "shopping"
        ],
        "properties": {
          "index": {
            "type": "array",
            "minItems": 24,
            "maxItems": 24
          }
        }
      }
    },
    "groups": {
      "type": "object",
      "required": [
        "shopping",
        "other"
      ]
    }
  }
}
