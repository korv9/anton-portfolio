{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "generated_at", "source", "model", "month", "method", "rows"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "minLength": 10},
    "source": {"type": "string", "minLength": 1},
    "model": {"const": "gold.mart_skill_trends_monthly"},
    "month": {"type": "string", "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"},
    "method": {"type": "string", "minLength": 1},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role_family", "skill", "ads_with_skill", "total_ads", "unique_employers", "skill_share",
                     "previous_year_skill_ads", "previous_year_total_ads", "previous_year_share", "share_yoy_pp"],
        "additionalProperties": false,
        "properties": {
          "role_family": {"type": "string", "minLength": 1},
          "skill": {"type": "string", "minLength": 1},
          "ads_with_skill": {"type": "integer", "minimum": 5},
          "total_ads": {"type": "integer", "minimum": 20},
          "unique_employers": {"type": "integer", "minimum": 0},
          "skill_share": {"type": "number", "minimum": 0, "maximum": 1},
          "previous_year_skill_ads": {"type": "integer", "minimum": 0},
          "previous_year_total_ads": {"type": "integer", "minimum": 1},
          "previous_year_share": {"type": "number", "minimum": 0, "maximum": 1},
          "share_yoy_pp": {"type": "number", "minimum": -100, "maximum": 100}
        }
      }
    }
  }
}
