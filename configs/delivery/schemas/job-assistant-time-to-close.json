{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "generated_at", "source", "window_days", "min_ads", "method", "rows"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "minLength": 10},
    "source": {"type": "string", "minLength": 1},
    "window_days": {"const": 30},
    "min_ads": {"type": "integer", "minimum": 1},
    "method": {"type": "string", "minLength": 1},
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["occupation", "outcome", "ads", "median_days_open"],
        "additionalProperties": false,
        "properties": {
          "occupation": {"type": "string", "minLength": 1},
          "outcome": {"enum": ["before_deadline", "to_deadline", "no_deadline", "all"]},
          "ads": {"type": "integer", "minimum": 1},
          "median_days_open": {"type": ["number", "null"], "minimum": 0}
        }
      }
    }
  }
}
