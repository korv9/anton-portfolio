{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "generated_at", "source", "latest_complete_week", "method", "rows"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "minLength": 10},
    "source": {"type": "string", "minLength": 1},
    "latest_complete_week": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "method": {"type": "string", "minLength": 1},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["week_start", "iso_week", "field_id", "ads", "vacancies", "days_covered", "complete"],
        "additionalProperties": false,
        "properties": {
          "week_start": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "iso_week": {"type": "string", "pattern": "^[0-9]{4}-W[0-9]{2}$"},
          "field_id": {"type": "string", "minLength": 1},
          "ads": {"type": "integer", "minimum": 0},
          "vacancies": {"type": ["integer", "null"], "minimum": 0},
          "days_covered": {"type": "integer", "minimum": 1, "maximum": 7},
          "complete": {"type": "boolean"}
        }
      }
    }
  }
}
