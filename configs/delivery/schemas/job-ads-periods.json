{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "generated_at", "source", "model", "period_kind", "latest_complete", "method", "rows"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "minLength": 10},
    "source": {"type": "string", "minLength": 1},
    "model": {"const": "gold.mart_job_ads_periods"},
    "period_kind": {"enum": ["week", "month", "year"]},
    "latest_complete": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "method": {"type": "string", "minLength": 1},
    "rows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["period_start", "role_family", "ads", "days_covered", "days_in_period", "complete"],
        "additionalProperties": false,
        "properties": {
          "period_start": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
          "role_family": {"type": "string", "minLength": 1},
          "ads": {"type": "integer", "minimum": 0},
          "days_covered": {"type": "integer", "minimum": 0, "maximum": 366},
          "days_in_period": {"type": "integer", "minimum": 7, "maximum": 366},
          "complete": {"type": "boolean"}
        }
      }
    }
  }
}
