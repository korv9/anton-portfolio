{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "name", "generated_at", "method", "coverage", "diagnostics", "grouping", "misfits", "notes"],
  "properties": {
    "name": {"const": "three-swedens"},
    "generated_at": {"type": "string", "minLength": 20},
    "method": {"type": "object", "required": ["social", "jobs", "votes", "geography", "mantel", "seed"]},
    "diagnostics": {
      "type": "object",
      "required": ["n", "tests", "chance_jaccard", "misfit_cutoff"],
      "properties": {
        "n": {"type": "integer", "minimum": 50},
        "tests": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object",
            "required": ["pair", "r", "partial_r", "p", "partial_p", "partial_p_holm", "permutations", "range", "reading"],
            "properties": {
              "r": {"type": "number", "minimum": -1, "maximum": 1},
              "partial_r": {"type": "number", "minimum": -1, "maximum": 1},
              "p": {"type": "number", "minimum": 0.0001, "maximum": 1},
              "partial_p": {"type": "number", "minimum": 0.0001, "maximum": 1},
              "permutations": {"const": 9999},
              "reading": {"enum": ["agree", "no measurable agreement"]}
            }
          }
        }
      }
    },
    "grouping": {"type": "object", "required": ["chosen_k", "candidates", "note"]},
    "misfits": {
      "type": "array", "minItems": 20, "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["code", "name", "rank", "agreement", "jaccard", "neighbours"],
        "properties": {"code": {"type": "string", "pattern": "^[0-9]{4}$"}}
      }
    },
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
