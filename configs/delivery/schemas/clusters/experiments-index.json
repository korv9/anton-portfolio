{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cluster experiments index (ml/experiments/export.py index)",
  "type": "object",
  "required": ["schema_version", "generated_at", "coordinates", "domains"],
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string"},
    "coordinates": {"type": "string", "minLength": 1},
    "domains": {
      "type": "object",
      "propertyNames": {"enum": ["philosophy", "symbolic", "jobs", "debates"]},
      "additionalProperties": {
        "type": "object",
        "required": ["champion", "question", "runs"],
        "properties": {
          "champion": {"type": ["string", "null"]},
          "question": {"type": "string", "minLength": 1},
          "runs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["run_id", "status", "label", "role", "created_at", "dataset_version",
                           "embedding", "clustering", "cluster_count", "noise_share"],
              "properties": {
                "run_id": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
                "status": {"enum": ["candidate", "champion", "rejected"]},
                "embedding": {"type": "object"},
                "clustering": {"type": "object"},
                "cluster_count": {"type": "integer", "minimum": 0},
                "noise_share": {"type": "number", "minimum": 0, "maximum": 1},
                "seed_ari": {"type": ["number", "null"]},
                "accepted": {"type": ["boolean", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
