{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "name", "title", "run_id", "method", "diagnostics"],
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "method": {"type": "object", "minProperties": 1},
    "diagnostics": {
      "type": "object",
      "required": ["n", "k", "noise_share", "silhouette_original", "bootstrap_ari", "null", "ami_reference", "status", "min_ari"],
      "properties": {
        "n": {"type": "integer", "minimum": 1},
        "k": {"type": "integer", "minimum": 0},
        "noise_share": {"type": "number", "minimum": 0, "maximum": 1},
        "silhouette_original": {"type": ["number", "null"]},
        "bootstrap_ari": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "required": ["mean", "p05", "p95", "rounds", "method"]}
          ]
        },
        "null": {
          "oneOf": [
            {"type": "null"},
            {"type": "object", "required": ["statistic", "kind", "observed", "p", "rounds"]}
          ]
        },
        "ami_reference": {"type": "object"},
        "status": {"enum": ["finding", "counter_example", "unvalidated"]}
      }
    },
    "members": {"type": "object", "required": ["columns", "rows"], "properties": {"rows": {"type": "array", "minItems": 1}}},
    "shares": {"type": "object", "required": ["columns", "rows"], "properties": {"rows": {"type": "array", "minItems": 1}}}
  }
}
