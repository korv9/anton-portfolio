{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "generated_at", "source", "model", "method", "rows"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "generated_at": {"type": "string", "minLength": 10},
    "source": {"type": "string", "minLength": 1},
    "model": {"const": "gold.mart_job_employer_top"},
    "method": {"type": "string", "minLength": 1},
    "rows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "object",
        "required": ["period_kind", "from", "until", "complete", "employers"],
        "additionalProperties": false,
        "properties": {
          "period_kind": {"enum": ["latest_12_months", "year"]},
          "from": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-01$"},
          "until": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-01$"},
          "complete": {"type": "boolean"},
          "employers": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "object",
              "required": ["rank", "employer", "ads"],
              "additionalProperties": false,
              "properties": {
                "rank": {"type": "integer", "minimum": 1, "maximum": 20},
                "employer": {"type": "string", "minLength": 1, "not": {"pattern": "[0-9]{6}[-+]?[0-9]{4}"}},
                "ads": {"type": "integer", "minimum": 1}
              }
            }
          }
        }
      }
    }
  }
}
