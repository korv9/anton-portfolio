{
  "schema_version": 2,
  "include": [
    "*"
  ],
  "exclude": [
    "catalog.json",
    "delivery.json",
    "offloaded.json",
    "*.md",
    "**/*.md",
    "*.txt",
    "**/*.txt",
    "*.html",
    "**/*.html",
    "*.pdf",
    "**/*.pdf",
    "*.bin",
    "**/*.bin",
    "jobs/market.json",
    "welfare/*",
    "taxes/*",
    "schema/*",
    "diva/*",
    "parquet/welfare/*",
    "parquet/welfare_indicator/*",
    "parquet/parliament_roll_calls/*",
    "parliament/now.json",
    "parliament/elections.json",
    "parliament/polls.json",
    "parliament/sessions.json",
    "parliament/studies.json",
    "parliament/issues.json",
    "parliament/news.json",
    "parliament/news-summaries.json",
    "jobs/*",
    "gold/marts/jobs.json",
    "parliament/workspace/*",
    "politics/parliament/parties/*",
    "politics/parliament/similarity/*",
    "politics/parliament/speakers/*",
    "politics/parliament/votes/*",
    "politics/parliament/manifest.json",
    "sweden/*",
    "job-assistant/*",
    "clusters/*"
  ],
  "schemas": {
    "ai-act/diffusion.json": "configs/delivery/schemas/ai-act-diffusion.json",
    "philosophy/moral/foundations.json": "configs/delivery/schemas/philosophy-moral-foundations.json",
    "philosophy/moral/ethics.json": "configs/delivery/schemas/philosophy-ethics-agreement.json",
    "humanities/oldbailey/extraction.json": "configs/delivery/schemas/humanities/oldbailey-extraction.json",
    "cluster-experiments/index.json": "configs/delivery/schemas/clusters/experiments-index.json"
  },
  "checks": [
    [
      "python",
      "platform/publish/validate_cluster_experiments.py",
      "--root",
      "{root}"
    ]
  ]
}
